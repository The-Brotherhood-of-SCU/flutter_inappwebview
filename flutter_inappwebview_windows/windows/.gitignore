flutter/

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
# Anchored with a leading slash so the rule matches ONLY the top-level
# `windows/x64/` build output dir. Without the slash, this pattern would
# match any nested `x64/` directory (including our `prebuilt/x64/Release/`
# cache, which we explicitly want to commit).
/x64/
/x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

packages/

# Prebuilt DLL cache — only `x64/Release/` is committed.
# `Debug/` and `RelWithDebInfo/` are not currently generated by `flutter build
# windows`; if a future change starts producing them, list them here too.
prebuilt/x64/Debug/
prebuilt/x64/RelWithDebInfo/